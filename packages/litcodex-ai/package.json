{
	"name": "@litfamily/litcodex",
	"version": "1.0.31",
	"description": "Codex CLI plugin that turns a request into a goal with checks, keeps the evidence in your project and hands unfinished work to the next session.",
	"keywords": [
		"codex",
		"codex-cli",
		"codex-plugin",
		"openai-codex",
		"litcodex",
		"lit-loop",
		"ai-agents",
		"agent-workflow",
		"planning",
		"code-review",
		"research",
		"korean",
		"office-documents"
	],
	"author": "LitCodex Authors",
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wjgoarxiv/litcodex.git"
	},
	"bugs": {
		"url": "https://github.com/wjgoarxiv/litcodex/issues"
	},
	"homepage": "https://github.com/wjgoarxiv/litcodex#readme",
	"type": "module",
	"bin": {
		"litcodex": "bin/litcodex.js"
	},
	"files": [
		"bin",
		"dist",
		"marketplace",
		"!marketplace/**/.*",
		"marketplace/.agents/plugins/marketplace.json",
		"marketplace/plugins/litcodex/.codex-plugin/**",
		"marketplace/plugins/litcodex/.mcp.json",
		"marketplace/plugins/litcodex/skills/lit-loop/.gitkeep",
		"marketplace/plugins/litcodex/skills/lit-code/scripts/go/templates/.editorconfig",
		"marketplace/plugins/litcodex/skills/lit-code/scripts/go/templates/.golangci.yml",
		"model-catalog.json",
		"README.md",
		"README-Ko-KR.md",
		"LICENSE",
		"readme-assets"
	],
	"dependencies": {
		"@litcodex/lit-loop": "1.0.31"
	},
	"bundledDependencies": [
		"@litcodex/lit-loop"
	],
	"optionalDependencies": {
		"node-pty": "1.1.0"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"postbuild": "node ../../scripts/mark-cli-executable.mjs --workspace .",
		"typecheck": "tsc --noEmit",
		"test": "vitest --run --passWithNoTests=false",
		"postinstall": "node dist/postinstall.js",
		"prepublishOnly": "npm --prefix ../.. run release:check",
		"prepack": "node ../../scripts/prepack-bundle-component.mjs",
		"postpack": "node ../../scripts/postpack-clean-component.mjs"
	},
	"engines": {
		"node": ">=22.0.0"
	}
}
