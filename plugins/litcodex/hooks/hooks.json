						"statusMessage": "\ud83d\udd25 LIT IGNITED \u00b7 lit-loop \ud83d\udd25"
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "^create_goal$",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/lit-loop/dist/cli.js\" hook pre-tool-use",
						"timeout": 5,
						"statusMessage": "\ud83d\udd25 LIT IGNITED \u00b7 lit-loop \ud83d\udd25"
					}
				]
			},
			{
				"matcher": "^Bash$",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/git-bash/dist/cli.js\" hook pre-tool-use",
						"timeout": 5,
						"statusMessage": "\ud83d\udd25 LIT IGNITED \u00b7 git-bash \ud83d\udd25"
					}
				]
			},
			{
				"matcher": "^(Bash|apply_patch|write|Write|edit|Edit|multi_edit|multiedit|MultiEdit|mcp__filesystem__write_file|mcp__filesystem__edit_file)$",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/rules/dist/cli.js\" hook pre-tool-use-humanizer",
						"timeout": 5,
						"statusMessage": "\ud83d\udd25 LIT IGNITED \u00b7 rules \ud83d\udd25"
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "^create_goal$",
				"hooks": [
