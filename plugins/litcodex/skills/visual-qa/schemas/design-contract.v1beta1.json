{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "litfamily.design-contract/v1beta1",
  "title": "LitFamily Design Contract v1beta1",
  "description": "Additive beta shape; the installed validator enforces base and referential rules.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "contract_id", "source_hash", "intent", "direction", "inventory", "accessibility", "localization", "performance", "evidence_policy", "omissions", "accepted_exceptions", "lane", "tokens", "component_behaviors", "responsive_transformations", "motion", "acceptance_criteria"],
  "properties": {
    "schema_id": { "const": "litfamily.design-contract/v1beta1" },
    "contract_id": { "$ref": "#/$defs/id" }, "source_hash": { "$ref": "#/$defs/hash" },
    "intent": { "type": "object" }, "direction": { "type": "object" }, "inventory": { "type": "object" },
    "accessibility": { "type": "object" }, "localization": { "type": "object" }, "performance": { "type": "object" },
    "evidence_policy": { "type": "object" }, "omissions": { "type": "array" }, "accepted_exceptions": { "type": "array" },
    "lane": { "enum": ["new-build", "brownfield", "redesign", "reference-fidelity", "design-system"] },
    "tokens": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/token" } },
    "component_behaviors": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/componentBehavior" } },
    "responsive_transformations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/responsiveTransformation" } },
    "motion": { "$ref": "#/$defs/motion" },
    "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/criterion" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$" }, "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "text": { "type": "string", "minLength": 1, "maxLength": 512 },
    "idList": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "token": { "type": "object", "additionalProperties": false, "required": ["id", "category", "value", "usage"], "properties": { "id": { "type": "string", "pattern": "^token:[a-z0-9][a-z0-9._/-]*$" }, "category": { "enum": ["color", "typography", "spacing", "radius", "shadow", "motion", "other"] }, "value": { "$ref": "#/$defs/text" }, "usage": { "$ref": "#/$defs/text" } } },
    "componentBehavior": { "type": "object", "additionalProperties": false, "required": ["component_id", "state_ids", "interaction_ids", "keyboard_behavior"], "properties": { "component_id": { "type": "string", "pattern": "^component:[a-z0-9][a-z0-9._/-]*$" }, "state_ids": { "$ref": "#/$defs/idList" }, "interaction_ids": { "$ref": "#/$defs/idList" }, "keyboard_behavior": { "$ref": "#/$defs/text" } } },
    "responsiveTransformation": { "type": "object", "additionalProperties": false, "required": ["route_id", "viewport_id", "behavior"], "properties": { "route_id": { "type": "string", "pattern": "^route:[a-z0-9][a-z0-9._/-]*$" }, "viewport_id": { "type": "string", "pattern": "^viewport:[a-z0-9][a-z0-9._/-]*$" }, "behavior": { "$ref": "#/$defs/text" } } },
    "motion": { "type": "object", "additionalProperties": false, "required": ["policy", "reduced_motion_behavior", "transitions"], "properties": { "policy": { "enum": ["none", "functional", "expressive"] }, "reduced_motion_behavior": { "$ref": "#/$defs/text" }, "transitions": { "type": "array", "items": { "$ref": "#/$defs/transition" } } } },
    "transition": { "type": "object", "additionalProperties": false, "required": ["id", "interaction_id", "duration_ms", "easing"], "properties": { "id": { "type": "string", "pattern": "^transition:[a-z0-9][a-z0-9._/-]*$" }, "interaction_id": { "type": "string", "pattern": "^interaction:[a-z0-9][a-z0-9._/-]*$" }, "duration_ms": { "type": "integer", "minimum": 0, "maximum": 10000 }, "easing": { "$ref": "#/$defs/text" } } },
    "criterion": { "type": "object", "additionalProperties": false, "required": ["id", "observable", "verification", "required", "inventory_ids"], "properties": { "id": { "type": "string", "pattern": "^criterion:[a-z0-9][a-z0-9._/-]*$" }, "observable": { "$ref": "#/$defs/text" }, "verification": { "enum": ["tests", "browser", "keyboard", "accessibility-tree", "screen-reader", "performance", "localization", "manual"] }, "required": { "const": true }, "inventory_ids": { "$ref": "#/$defs/idList" } } }
  }
}
