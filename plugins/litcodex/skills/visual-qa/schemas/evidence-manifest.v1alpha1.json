{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "litfamily.evidence-manifest/v1alpha1",
  "title": "LitFamily visual evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "created_at",
    "maximum_age_seconds",
    "design_contract_hash",
    "source_hash",
    "capture_hash",
    "environment",
    "capabilities",
    "inventory",
    "review_receipt_hashes",
    "cleanup",
    "blockers",
    "findings"
  ],
  "properties": {
    "schema_id": { "const": "litfamily.evidence-manifest/v1alpha1" },
    "created_at": { "type": "string", "format": "date-time" },
    "maximum_age_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
    "design_contract_hash": { "$ref": "#/$defs/hash" },
    "source_hash": { "$ref": "#/$defs/hash" },
    "capture_hash": { "$ref": "#/$defs/hash" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "renderer_identity",
        "capture_tool",
        "locale",
        "color_scheme",
        "reduced_motion",
        "process_owned",
        "session_owned"
      ],
      "properties": {
        "surface": { "enum": ["web", "application", "tui"] },
        "renderer_identity": { "type": "string", "minLength": 1 },
        "capture_tool": { "type": "string", "minLength": 1 },
        "locale": { "type": "string", "minLength": 2 },
        "color_scheme": { "enum": ["light", "dark", "system"] },
        "reduced_motion": { "type": "boolean" },
        "process_owned": { "type": "boolean" },
        "session_owned": { "type": "boolean" }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capture", "auth", "independent_review"],
      "properties": {
        "capture": { "type": "boolean" },
        "auth": { "type": "boolean" },
        "independent_review": { "type": "boolean" }
      }
    },
    "inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence_hash", "captured_at"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "status": { "enum": ["captured", "omitted", "accepted-exception"] },
          "evidence_hash": { "$ref": "#/$defs/hash" },
          "captured_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "review_receipt_hashes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/hash" }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "temporary_artifacts_removed", "session_terminated", "auth_state_removed"],
      "properties": {
        "status": { "enum": ["pending", "complete"] },
        "temporary_artifacts_removed": { "type": "boolean" },
        "session_terminated": { "type": "boolean" },
        "auth_state_removed": { "type": "boolean" }
      }
    },
    "blockers": {
      "type": "array",
      "items": { "type": "string", "pattern": "^BLOCKED_[A-Z0-9_]+$" }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*:[a-z0-9][a-z0-9._/-]*$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "message", "open"],
      "properties": {
        "severity": { "enum": ["critical", "high", "major", "minor"] },
        "message": { "type": "string", "minLength": 1 },
        "open": { "type": "boolean" }
      }
    }
  }
}
