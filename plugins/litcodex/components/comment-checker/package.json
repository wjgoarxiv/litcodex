{
	"name": "@litcodex/comment-checker",
	"version": "1.0.9",
	"description": "LitCodex Comment-Checker hook: flags low-value / AI-slop comments introduced by edits.",
	"type": "module",
	"private": true,
	"bin": {
		"litcodex-comment-checker": "./dist/cli.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"postbuild": "node ../../../../scripts/mark-cli-executable.mjs --workspace .",
		"typecheck": "tsc --noEmit",
		"test": "vitest --run --passWithNoTests=false"
	},
	"engines": {
		"node": ">=22.0.0"
	}
}
