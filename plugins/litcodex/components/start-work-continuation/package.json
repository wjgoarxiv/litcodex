{
	"name": "@litcodex/start-work-continuation",
	"version": "1.0.9",
	"description": "LitCodex Start-Work continuation hook: resumes in-flight start-work state on root Stop.",
	"type": "module",
	"private": true,
	"bin": {
		"litcodex-start-work-continuation": "./dist/cli.js"
	},
	"files": [
		"dist",
		"directive.md"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"postbuild": "node ../../../../scripts/mark-cli-executable.mjs --workspace .",
		"typecheck": "tsc --noEmit",
		"pretest": "npm run build",
		"test": "vitest --run --passWithNoTests=false"
	},
	"engines": {
		"node": ">=22.0.0"
	}
}
