{
	"name": "@litcodex/git-bash",
	"version": "1.0.12",
	"description": "LitCodex Git-Bash hook: reminds Windows sessions to prefer the git_bash MCP before the built-in shell.",
	"type": "module",
	"private": true,
	"bin": {
		"litcodex-git-bash": "./dist/cli.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"postbuild": "node ../../../../scripts/mark-cli-executable.mjs --workspace .",
		"typecheck": "tsc --noEmit",
		"test": "vitest --run --passWithNoTests=false"
	},
	"engines": {
		"node": ">=22.0.0"
	}
}
